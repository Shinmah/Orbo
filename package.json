{
  "name": "orbo",
  "productName": "Orbo",
  "version": "1.0.0",
  "description": "Orbo — apprendre la géographie en jouant : capitales, drapeaux et carte du monde.",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Orbo",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "data:fetch": "tsx scripts/data/fetch.ts",
    "data:build": "tsx scripts/data/build.ts",
    "data:validate": "tsx scripts/data/validate.ts",
    "data": "npm run data:build && npm run data:validate",
    "icons": "tsx scripts/icons.ts",
    "electron:dev": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.9",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.4",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-server": "^3.0.4",
    "@types/topojson-specification": "^1.0.5",
    "d3-geo": "^3.1.1",
    "d3-interpolate": "^3.0.1",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "flag-icons": "^7.5.0",
    "mapshaper": "^0.7.72",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
